<MenuScreen>:
    canvas.before:
        Color:
            rgba: 0.15, 0.15, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Image:
        source: 'Images/game_logo.png'
        size_hint: None, None
        size: root.width * 0.85, root.width * 0.85 * 0.45
        pos: root.width / 2 - self.width / 2, root.height * 0.28
        allow_stretch: True
        keep_ratio: True

    # START
    Widget:
        id: btn_start
        size_hint: None, None
        size: 320, 90
        pos: root.width / 2 - 160, root.height * 0.30
        canvas:
            Color:
                rgba: 0.1, 0.8, 0.3, 0.85
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "START"
            font_size: 40
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    # OPZIONI
    Widget:
        id: btn_options
        size_hint: None, None
        size: 320, 90
        pos: root.width / 2 - 160, root.height * 0.16
        canvas:
            Color:
                rgba: 0.1, 0.4, 0.9, 0.85
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "OPTIONS"
            font_size: 40
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    # ESCI
    Widget:
        id: btn_quit
        size_hint: None, None
        size: 320, 90
        pos: root.width / 2 - 160, root.height * 0.03
        canvas:
            Color:
                rgba: 0.75, 0.1, 0.1, 0.85
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "QUIT"
            font_size: 40
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

<OptionsScreen>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "OPTIONS"

    # ── MUSICA ─────────────────────────────────────────────────
    Label:
        text: "Music"
        font_size: 26
        bold: True
        color: 0.6, 0.6, 0.6, 1
        size: root.width - 40, 36
        pos: 20, root.height * 0.79
        text_size: self.size
        halign: 'left'
        valign: 'middle'

    Widget:
        id: btn_music_toggle
        size_hint: None, None
        size: (root.width - 46) / 2, 72
        pos: 20, root.height * 0.71
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.28, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: (1, 0.8, 0.1, 1) if root.tmp_music_on else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 3, self.y - 3, self.width + 6, self.height + 6, 12
                width: 3
        Label:
            text: "ON"
            font_size: 30
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_music_toggle_off
        size_hint: None, None
        size: (root.width - 46) / 2, 72
        pos: 26 + (root.width - 46) / 2, root.height * 0.71
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.28, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: (1, 0.8, 0.1, 1) if not root.tmp_music_on else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 3, self.y - 3, self.width + 6, self.height + 6, 12
                width: 3
        Label:
            text: "OFF"
            font_size: 30
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    # ── TIMER ──────────────────────────────────────────────────
    Label:
        text: "Timer (seconds)"
        font_size: 26
        bold: True
        color: 0.6, 0.6, 0.6, 1
        size: root.width - 40, 36
        pos: 20, root.height * 0.62
        text_size: self.size
        halign: 'left'
        valign: 'middle'

    Widget:
        id: btn_timer_10
        size_hint: None, None
        size: (root.width - 58) / 4, 72
        pos: 20, root.height * 0.54
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.28, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: (1, 0.8, 0.1, 1) if root.tmp_timer == 10 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 3, self.y - 3, self.width + 6, self.height + 6, 12
                width: 3
        Label:
            text: "10"
            font_size: 28
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_timer_60
        size_hint: None, None
        size: (root.width - 58) / 4, 72
        pos: 26 + (root.width - 58) / 4, root.height * 0.54
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.28, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: (1, 0.8, 0.1, 1) if root.tmp_timer == 60 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 3, self.y - 3, self.width + 6, self.height + 6, 12
                width: 3
        Label:
            text: "60"
            font_size: 28
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_timer_90
        size_hint: None, None
        size: (root.width - 58) / 4, 72
        pos: 32 + (root.width - 58) / 4 * 2, root.height * 0.54
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.28, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: (1, 0.8, 0.1, 1) if root.tmp_timer == 90 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 3, self.y - 3, self.width + 6, self.height + 6, 12
                width: 3
        Label:
            text: "90"
            font_size: 28
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_timer_120
        size_hint: None, None
        size: (root.width - 58) / 4, 72
        pos: 38 + (root.width - 58) / 4 * 3, root.height * 0.54
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.28, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: (1, 0.8, 0.1, 1) if root.tmp_timer == 120 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 3, self.y - 3, self.width + 6, self.height + 6, 12
                width: 3
        Label:
            text: "120"
            font_size: 28
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    # ── ROUND ──────────────────────────────────────────────────
    Label:
        text: "Round"
        font_size: 26
        bold: True
        color: 0.6, 0.6, 0.6, 1
        size: root.width - 40, 36
        pos: 20, root.height * 0.45
        text_size: self.size
        halign: 'left'
        valign: 'middle'

    Widget:
        id: btn_rounds_3
        size_hint: None, None
        size: (root.width - 46) / 2, 72
        pos: 20, root.height * 0.37
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.28, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: (1, 0.8, 0.1, 1) if root.tmp_rounds == 3 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 3, self.y - 3, self.width + 6, self.height + 6, 12
                width: 3
        Label:
            text: "3 Rounds"
            font_size: 28
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_rounds_5
        size_hint: None, None
        size: (root.width - 46) / 2, 72
        pos: 26 + (root.width - 46) / 2, root.height * 0.37
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.28, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: (1, 0.8, 0.1, 1) if root.tmp_rounds == 5 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 3, self.y - 3, self.width + 6, self.height + 6, 12
                width: 3
        Label:
            text: "5 Rounds"
            font_size: 28
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Label:
        text: ("Best of 3" if root.tmp_rounds == 3 else "Best of 5")
        font_size: 22
        color: 0.5, 0.5, 0.5, 1
        size: root.width - 40, 34
        pos: 20, root.height * 0.32
        text_size: self.size
        halign: 'center'
        valign: 'middle'

    # ── SALVA / SAVE ───────────────────────────────────────────
    Widget:
        id: btn_save
        size_hint: None, None
        size: root.width - 80, 86
        pos: 40, root.height * 0.17
        canvas:
            Color:
                rgba: 0.85, 0.5, 0.05, 0.95
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "SAVE"
            font_size: 34
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_back
        size_hint: None, None
        size: 240, 62
        pos: 20, root.height * 0.89
        canvas:
            Color:
                rgba: 0.3, 0.3, 0.3, 0.85
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [14]
        Label:
            text: "< BACK"
            font_size: 22
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    # ── DIALOGO CONFERMA ───────────────────────────────────────
    Widget:
        size: root.width, root.height
        pos: root.pos
        opacity: 1 if root.show_confirm else 0
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.72
            Rectangle:
                pos: self.pos
                size: self.size

    Widget:
        size_hint: None, None
        size: root.width * 0.82, 320
        pos: root.width * 0.09, root.height / 2 - 160
        opacity: 1 if root.show_confirm else 0
        canvas:
            Color:
                rgba: 0.18, 0.18, 0.22, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [22]
            Color:
                rgba: 0.85, 0.5, 0.05, 1
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, 22
                width: 2.5

    Label:
        text: "Unsaved changes!\nWhat do you want to do?"
        font_size: 28
        bold: True
        color: 1, 1, 1, 1
        size: root.width * 0.82, 120
        pos: root.width * 0.09, root.height / 2 + 30
        opacity: 1 if root.show_confirm else 0
        text_size: self.size
        halign: 'center'
        valign: 'middle'

    Widget:
        id: btn_confirm_save
        size_hint: None, None
        size: root.width * 0.36, 75
        pos: root.width * 0.09 + 20, root.height / 2 - 140
        opacity: 1 if root.show_confirm else 0
        canvas:
            Color:
                rgba: 0.85, 0.5, 0.05, 0.95
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [16]
        Label:
            text: "SAVE"
            font_size: 26
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_confirm_discard
        size_hint: None, None
        size: root.width * 0.36, 75
        pos: root.width * 0.09 + root.width * 0.36 + 24, root.height / 2 - 140
        opacity: 1 if root.show_confirm else 0
        canvas:
            Color:
                rgba: 0.65, 0.1, 0.1, 0.95
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [16]
        Label:
            text: "DISCARD"
            font_size: 26
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

<CharSelectScreen>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # ── ANTEPRIME FULLBODY (sotto tutto il resto) ───────────────
    Image:
        id: char_preview_img
        source: root.fullbody_source
        size_hint: None, None
        size: root.width * 0.55, root.height * 0.65
        pos: 0, root.height * 0.02
        allow_stretch: True
        keep_ratio: True
        opacity: 1 if root.fullbody_source else 0

    Image:
        source: root.enemy_fullbody_source if not root.enemy_placeholder else ''
        size_hint: None, None
        size: root.width * 0.55, root.height * 0.65
        pos: root.width * 0.45, root.height * 0.02
        allow_stretch: True
        keep_ratio: True
        opacity: 1 if (root._confirmed and not root.enemy_placeholder and root.enemy_fullbody_source) else 0
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            PushMatrix
            Scale:
                x: -1
                origin: self.center
        canvas.after:
            PopMatrix

    # ── TITOLO ─────────────────────────────────────────────────
    Label:
        text: "SELECT CHARACTER"
        font_size: 36
        bold: True
        color: 1, 1, 1, 1
        size: root.width, 60
        pos: root.x, root.height * 0.88
        halign: 'center'
        valign: 'middle'
        text_size: self.size

    # ── GRIGLIA PERSONAGGI (riga 1) — i bordi sono nel canvas ──
    Widget:
        id: char_0
        size_hint: None, None
        size: 130, 130
        pos: root.width / 2 - 280, root.height * 0.68
        canvas:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                source: 'PG/Preview/Giuse_preview.png'
                pos: self.pos
                size: self.size
            Color:
                rgba: (1, 1, 1, 1) if root.selected == 0 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 4, self.y - 4, self.width + 8, self.height + 8, 14
                width: 3

    Widget:
        id: char_1
        size_hint: None, None
        size: 130, 130
        pos: root.width / 2 - 280 + 150, root.height * 0.68
        canvas:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                source: 'PG/Preview/Poz_preview.png'
                pos: self.pos
                size: self.size
            Color:
                rgba: (1, 1, 1, 1) if root.selected == 1 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 4, self.y - 4, self.width + 8, self.height + 8, 14
                width: 3

    Widget:
        id: char_2
        size_hint: None, None
        size: 130, 130
        pos: root.width / 2 - 280 + 300, root.height * 0.68
        canvas:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                source: 'PG/Preview/Ruben_preview.png'
                pos: self.pos
                size: self.size
            Color:
                rgba: (1, 1, 1, 1) if root.selected == 2 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 4, self.y - 4, self.width + 8, self.height + 8, 14
                width: 3

    Widget:
        id: char_3
        size_hint: None, None
        size: 130, 130
        pos: root.width / 2 - 280 + 450, root.height * 0.68
        canvas:
            Color:
                rgba: 0.9, 0.7, 0.1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12]
            Color:
                rgba: (1, 1, 1, 1) if root.selected == 3 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 4, self.y - 4, self.width + 8, self.height + 8, 14
                width: 3

    # ── GRIGLIA PERSONAGGI (riga 2) ────────────────────────────
    Widget:
        id: char_4
        size_hint: None, None
        size: 130, 130
        pos: root.width / 2 - 280, root.height * 0.52
        canvas:
            Color:
                rgba: 0.8, 0.3, 0.9, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12]
            Color:
                rgba: (1, 1, 1, 1) if root.selected == 4 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 4, self.y - 4, self.width + 8, self.height + 8, 14
                width: 3

    Widget:
        id: char_5
        size_hint: None, None
        size: 130, 130
        pos: root.width / 2 - 280 + 150, root.height * 0.52
        canvas:
            Color:
                rgba: 0.1, 0.8, 0.8, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12]
            Color:
                rgba: (1, 1, 1, 1) if root.selected == 5 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 4, self.y - 4, self.width + 8, self.height + 8, 14
                width: 3

    Widget:
        id: char_6
        size_hint: None, None
        size: 130, 130
        pos: root.width / 2 - 280 + 300, root.height * 0.52
        canvas:
            Color:
                rgba: 0.95, 0.5, 0.1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12]
            Color:
                rgba: (1, 1, 1, 1) if root.selected == 6 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 4, self.y - 4, self.width + 8, self.height + 8, 14
                width: 3

    Widget:
        id: char_7
        size_hint: None, None
        size: 130, 130
        pos: root.width / 2 - 280 + 450, root.height * 0.52
        canvas:
            Color:
                rgba: 0.5, 0.5, 0.5, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12]
            Color:
                rgba: (1, 1, 1, 1) if root.selected == 7 else (0, 0, 0, 0)
            Line:
                rounded_rectangle: self.x - 4, self.y - 4, self.width + 8, self.height + 8, 14
                width: 3

    # ── CORNICE NEMICO (roulette, no widget separato) ───────────
    Widget:
        id: enemy_border
        size_hint: None, None
        size: 138, 138
        pos: root.width / 2 - 284, root.height * 0.68 - 4
        opacity: 0
        canvas:
            Color:
                rgba: 1, 0.1, 0.1, 1
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, 14
                width: 3

    # ── VS IMAGE ───────────────────────────────────────────────
    Image:
        source: 'Images/vs.png'
        size_hint: None, None
        size: 440, 220
        pos: root.width / 2 - 220, root.height * 0.32
        allow_stretch: True
        keep_ratio: True

    # ── NOME PERSONAGGIO ───────────────────────────────────────
    Label:
        id: char_name_label
        text: "Jules"
        font_size: 32
        bold: True
        color: 1, 1, 0, 1
        size: root.width, 50
        pos: root.x, root.height * 0.44
        halign: 'center'
        valign: 'middle'
        text_size: self.size

    # ── PULSANTE NEXT ──────────────────────────────────────────
    Widget:
        id: btn_fight
        size_hint: None, None
        size: 280, 80
        pos: root.width - 300, root.height * 0.02
        canvas:
            Color:
                rgba: 0.85, 0.1, 0.1, 0.9
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "NEXT >"
            font_size: 34
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_back
        size_hint: None, None
        size: 180, 60
        pos: 20, root.height * 0.93
        canvas:
            Color:
                rgba: 0.3, 0.3, 0.3, 0.85
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [14]
        Label:
            text: "< BACK"
            font_size: 24
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

<ArenaSelectScreen>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "SELECT ARENA"
        font_size: 36
        bold: True
        color: 1, 1, 1, 1
        size: root.width, 60
        pos: root.x, root.height * 0.82

    Widget:
        id: arena_0
        size_hint: None, None
        size: root.width * 0.38, 80
        pos: 20, root.height * 0.65
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.25, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
        Label:
            text: "Il CAF"
            font_size: 28
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: arena_1
        size_hint: None, None
        size: root.width * 0.38, 80
        pos: 20, root.height * 0.52
        canvas:
            Color:
                rgba: 0.25, 0.25, 0.25, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
        Label:
            text: "Frociest HQ"
            font_size: 28
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: arena_border
        size_hint: None, None
        size: root.width * 0.38 + 6, 86
        pos: 17, root.height * 0.65 - 3
        canvas:
            Color:
                rgba: 1, 0.8, 0.1, 1
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, 12
                width: 3

    # ── CORNICE MARRONE ATTORNO ALL'ANTEPRIMA ARENA ────────────
    Widget:
        size_hint: None, None
        size: root.width * 0.46 + 24, root.height * 0.43 + 24
        pos: root.width * 0.51 - 12, root.height * 0.42 - 12
        canvas:
            Color:
                rgba: 0.45, 0.22, 0.05, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [8]
            Color:
                rgba: 0.62, 0.32, 0.1, 1
            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, 8
                width: 4
            Color:
                rgba: 0.28, 0.12, 0.02, 1
            Line:
                rounded_rectangle: self.x + 6, self.y + 6, self.width - 12, self.height - 12, 5
                width: 2

    Image:
        id: arena_preview
        source: 'Images/Arena/wallpaper.png'
        size_hint: None, None
        size: root.width * 0.46, root.height * 0.43
        pos: root.width * 0.51, root.height * 0.42
        allow_stretch: True
        keep_ratio: False

    Widget:
        id: btn_fight
        size_hint: None, None
        size: 320, 90
        pos: root.width / 2 - 160, root.height * 0.12
        canvas:
            Color:
                rgba: 0.85, 0.1, 0.1, 0.9
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "FIGHT!"
            font_size: 38
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_back
        size_hint: None, None
        size: 180, 60
        pos: 20, root.height * 0.88
        canvas:
            Color:
                rgba: 0.3, 0.3, 0.3, 0.85
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [14]
        Label:
            text: "< BACK"
            font_size: 24
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

<SplashScreen>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: "Developed by"
        font_size: 28
        bold: True
        color: 1, 1, 1, 0.9
        size_hint: None, None
        size: root.width, 50
        pos: root.x, root.height / 2 + root.width * 0.22
    Image:
        source: 'Images/dev.png'
        size_hint: None, None
        size: root.width * 0.5, root.width * 0.5
        pos: root.width / 2 - self.width / 2, root.height / 2 - self.height / 2
        allow_stretch: True
        keep_ratio: True

<GameScreen>:
    FighterGame:
        id: game_widget
        size: root.size
        pos: root.pos
