<RoundButton>:
    canvas.before:
        Color:
            rgba: self.btn_color
        Ellipse:
            pos: self.pos
            size: self.size
    Label:
        text: root.text
        bold: True
        font_size: root.font_size
        color: 1, 1, 1, 0.95
        size: root.size
        pos: root.pos


<FighterGame>:
    player: player_id
    enemy:  enemy_id
    joystick: joystick_id
    hitbox:   hitbox_id

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            source: self.bg_source
            size: self.size
            pos: self.pos
        # ── OMBRA GIOCATORE ──
        Color:
            rgba: 0, 0, 0, 0.35
        Ellipse:
            pos: self.player_x + 80, 35
            size: 340, 60
        # ── OMBRA NEMICO ──
        Color:
            rgba: 0, 0, 0, 0.35
        Ellipse:
            pos: self.enemy_x + 80, 35
            size: 340, 60

    # ── GIOCATORE ──────────────────────────────────────────────
    Fighter:
        id: player_id
        size: 500, 500
        pos: 200, 50

        Image:
            source: player_id.current_source
            size: player_id.size
            pos: player_id.pos
            anim_delay: 0.1
            anim_loop: 0
            allow_stretch: True
            opacity: 1 if self.texture else 0

            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                PushMatrix
                Scale:
                    x: player_id.scale_x
                    origin: self.center
            canvas.after:
                PopMatrix

    Widget:
        id: hitbox_id
        size: 0, 0
        pos: -1000, -1000

    # ── NEMICO ─────────────────────────────────────────────────
    Fighter:
        id: enemy_id
        size: 500, 500
        pos: root.width - 700, 50

        # Placeholder: rettangolo colorato
        canvas.after:
            Color:
                rgba: root.enemy_placeholder_color if root.enemy_is_placeholder else (0,0,0,0)
            Rectangle:
                pos: enemy_id.pos
                size: enemy_id.size

        Image:
            source: root.enemy_source if not root.enemy_is_placeholder else ''
            size: enemy_id.size
            pos: enemy_id.pos
            anim_delay: 0.1
            anim_loop: 0
            allow_stretch: True
            opacity: 0 if root.enemy_is_placeholder else 1

            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                PushMatrix
                Scale:
                    x: enemy_id.scale_x
                    origin: self.center
            canvas.after:
                PopMatrix

    # ── BARRA HP GIOCATORE ─────────────────────────────────────
    Widget:
        size: root.width / 2 - 120, 40
        pos: 30, root.height - 80
        canvas:
            Color:
                rgba: 0.1, 0.1, 0.1, 0.7
            Rectangle:
                size: self.size
                pos: self.pos
            Color:
                rgba: (0, 0.85, 0, 1) if player_id.hp > 125 else ((1, 0.85, 0, 1) if player_id.hp > 25 else (0.9, 0.1, 0.1, 1))
            Rectangle:
                size: max(0, (root.width / 2 - 120) * player_id.hp / 250), 40
                pos: self.pos

    # ── PALLINI VITTORIE GIOCATORE (max 3) ────────────────────
    Widget:
        size: 30, 30
        pos: 30, root.height - 120
        canvas:
            Color:
                rgba: (0.2, 0.8, 0.2, 1) if root.player_wins >= 1 else (0.3, 0.3, 0.3, 1)
            Ellipse:
                pos: self.pos
                size: self.size
    Widget:
        size: 30, 30
        pos: 68, root.height - 120
        canvas:
            Color:
                rgba: (0.2, 0.8, 0.2, 1) if root.player_wins >= 2 else (0.3, 0.3, 0.3, 1)
            Ellipse:
                pos: self.pos
                size: self.size
    Widget:
        size: 30, 30
        pos: 106, root.height - 120
        opacity: 1 if root.max_dots >= 3 else 0
        canvas:
            Color:
                rgba: (0.2, 0.8, 0.2, 1) if root.player_wins >= 3 else (0.3, 0.3, 0.3, 1)
            Ellipse:
                pos: self.pos
                size: self.size


    # ── BARRA HP NEMICO ────────────────────────────────────────
    Widget:
        size: root.width / 2 - 120, 40
        pos: root.width / 2 + 90, root.height - 80
        canvas:
            Color:
                rgba: 0.1, 0.1, 0.1, 0.7
            Rectangle:
                size: self.size
                pos: self.pos
            Color:
                rgba: (0, 0.85, 0, 1) if enemy_id.hp > 125 else ((1, 0.85, 0, 1) if enemy_id.hp > 25 else (0.9, 0.1, 0.1, 1))
            Rectangle:
                size: max(0, (root.width / 2 - 120) * enemy_id.hp / 250), 40
                pos: self.pos

    # ── PALLINI VITTORIE NEMICO (max 3) ───────────────────────
    Widget:
        size: 30, 30
        pos: root.width - 60, root.height - 120
        canvas:
            Color:
                rgba: (0.9, 0.2, 0.2, 1) if root.enemy_wins >= 1 else (0.3, 0.3, 0.3, 1)
            Ellipse:
                pos: self.pos
                size: self.size
    Widget:
        size: 30, 30
        pos: root.width - 98, root.height - 120
        canvas:
            Color:
                rgba: (0.9, 0.2, 0.2, 1) if root.enemy_wins >= 2 else (0.3, 0.3, 0.3, 1)
            Ellipse:
                pos: self.pos
                size: self.size
    Widget:
        size: 30, 30
        pos: root.width - 136, root.height - 120
        opacity: 1 if root.max_dots >= 3 else 0
        canvas:
            Color:
                rgba: (0.9, 0.2, 0.2, 1) if root.enemy_wins >= 3 else (0.3, 0.3, 0.3, 1)
            Ellipse:
                pos: self.pos
                size: self.size


    # ── TIMER ──────────────────────────────────────────────────
    Label:
        id: timer_label
        text: root.timer_text
        font_size: 48
        bold: True
        color: 1, 1, 1, 1
        size: 180, 60
        pos: root.width / 2 - 90, root.height - 85

    # ── COUNTDOWN ──────────────────────────────────────────────
    Image:
        source: root.countdown_image
        size_hint: None, None
        size: root.width * 0.35, root.width * 0.35
        pos: root.width * 0.325, root.height / 2 - root.width * 0.175
        allow_stretch: True
        keep_ratio: True
        opacity: 1 if root.countdown_image else 0

    # ── VINCITORE DEL ROUND ────────────────────────────────────
    Image:
        source: root.winner_image
        size_hint: None, None
        size: root.width * 0.7, root.width * 0.7 * 0.4
        pos: root.width * 0.15, root.height / 2 - root.width * 0.14
        allow_stretch: True
        keep_ratio: True
        opacity: 1 if root.winner_image else 0

    # ── JOYSTICK ───────────────────────────────────────────────
    Joystick:
        id: joystick_id
        size_hint: 0.5, 1
        pos: 0, 0
        canvas:
            Color:
                rgba: 1, 1, 1, (0.25 if self.active else 0)
            Ellipse:
                pos: self.background_pos
                size: 200, 200
            Color:
                rgba: 1, 1, 1, (0.55 if self.active else 0)
            Ellipse:
                pos: self.knob_pos[0]-40, self.knob_pos[1]-40
                size: 80, 80

    # ── PULSANTI AZIONE (a metà altezza, destra) ───────────────
    # Layout diamond: Y (su/giallo), X (sinistra/blu), B (destra/rosso), A (giù/verde)
    # Centro diamante: root.width - 255, root.height / 2

    # Y - SALTO (in alto, giallo)
    RoundButton:
        id: btn_jump
        text: "Y"
        font_size: 28
        btn_color: 0.95, 0.85, 0, 0.55
        size_hint: None, None
        size: 110, 110
        pos: root.width - 255, root.height / 2 + 120

    # X - PUGNO (a sinistra, blu)
    RoundButton:
        id: btn_punch
        text: "X"
        font_size: 28
        btn_color: 0.1, 0.3, 0.95, 0.55
        size_hint: None, None
        size: 110, 110
        pos: root.width - 365, root.height / 2

    # B - CALCIO (a destra, rosso)
    RoundButton:
        id: btn_kick
        text: "B"
        font_size: 28
        btn_color: 0.9, 0.1, 0.1, 0.55
        size_hint: None, None
        size: 110, 110
        pos: root.width - 145, root.height / 2

    # A - ACCOVACCIATI (in basso, verde)
    RoundButton:
        id: btn_crouch
        text: "A"
        font_size: 28
        btn_color: 0.1, 0.75, 0.1, 0.55
        size_hint: None, None
        size: 110, 110
        pos: root.width - 255, root.height / 2 - 120

    # ── PULSANTE PAUSA (angolo alto destra) ────────────────────
    Widget:
        id: btn_pause
        size_hint: None, None
        size: 80, 80
        pos: root.width - 95, root.height - 95
        opacity: 0 if root.paused else 1
        canvas:
            Color:
                rgba: 0, 0, 0, 0.45
            Ellipse:
                pos: self.pos
                size: self.size
            Color:
                rgba: 1, 1, 1, 0.8
            # Due barre pause
            Rectangle:
                pos: self.x + 22, self.y + 18
                size: 12, 44
            Rectangle:
                pos: self.x + 46, self.y + 18
                size: 12, 44

    # ── MENÙ PAUSA ─────────────────────────────────────────────
    Widget:
        size: root.width, root.height
        pos: root.pos
        opacity: 1 if root.paused else 0
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.65
            Rectangle:
                pos: self.pos
                size: self.size

    Label:
        text: "PAUSE"
        font_size: 72
        bold: True
        color: 1, 1, 0, root.paused and 1 or 0
        size: root.width, 100
        pos: root.x, root.height * 0.72

    Widget:
        id: btn_resume
        size_hint: None, None
        size: 320, 90
        pos: root.width / 2 - 160, root.height * 0.55
        opacity: 1 if root.paused else 0
        canvas:
            Color:
                rgba: 0.1, 0.75, 0.2, 0.9
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "RESUME"
            font_size: 36
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_pause_menu
        size_hint: None, None
        size: 320, 90
        pos: root.width / 2 - 160, root.height * 0.4
        opacity: 1 if root.paused else 0
        canvas:
            Color:
                rgba: 0.1, 0.4, 0.9, 0.9
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "MENU"
            font_size: 36
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos

    Widget:
        id: btn_pause_quit
        size_hint: None, None
        size: 320, 90
        pos: root.width / 2 - 160, root.height * 0.25
        opacity: 1 if root.paused else 0
        canvas:
            Color:
                rgba: 0.8, 0.1, 0.1, 0.9
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        Label:
            text: "QUIT"
            font_size: 36
            bold: True
            color: 1, 1, 1, 1
            size: self.parent.size
            pos: self.parent.pos
